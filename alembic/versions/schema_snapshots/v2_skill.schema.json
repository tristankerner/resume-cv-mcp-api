        "action"
      ],
      "title": "Escalation",
      "type": "object"
    },
    "Guardrail": {
      "additionalProperties": false,
      "description": "A rule that holds regardless of the posting.\n\n`instead` is what makes one actionable: a prohibition with no alternative\ngets worked around under pressure to produce something.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "never",
            "always",
            "ask-first",
            "prefer"
          ],
          "title": "Severity",
          "type": "string"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
