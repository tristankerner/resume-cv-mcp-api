    "CoverLetterGuidance": {
      "additionalProperties": false,
      "description": "The letter, which is a different problem from the resume.\n\nThe resume argues from evidence and is read in thirty seconds. The letter\nanswers \"why this job, and why you\" in my own voice, and it is the only\nplace the narrative material is any use. It gets its own section for the\nsame reason the professional summary does: it is the part most often turned\ninto something that could have been sent to anyone.",
      "properties": {
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "structure": {
          "default": [],
          "items": {
            "type": "string"
          },
