    "Escalation": {
      "additionalProperties": false,
      "description": "A condition where the right move is to stop and say so.\n\nThese are the cases where quietly carrying on produces a plausible document\nbuilt on something wrong \u2014 a broken join, stale data, an unmet requirement.",
      "properties": {
        "condition": {
          "title": "Condition",
