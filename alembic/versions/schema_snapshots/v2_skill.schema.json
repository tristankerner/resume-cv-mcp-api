          "type": "array"
        },
        "proof_selection": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Proof Selection",
          "type": "array"
        },
        "story_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
