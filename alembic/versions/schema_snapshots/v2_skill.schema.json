    "OutputSpec": {
      "additionalProperties": false,
      "description": "One artifact a run can produce. The layout constraints are ATS-driven\nrather than aesthetic \u2014 parsers mishandle multi-column text, tables, and\ngraphics.\n\nThere is one of these per artifact rather than one per run: a cover letter\nis a different document with a different length, a different file name, and\ndifferent contents in its header, and folding it into the resume's spec\nproduced a letter that read like a resume in paragraphs.",
      "properties": {
        "artifact": {
          "enum": [
            "resume",
            "cover-letter"
          ],
          "title": "Artifact",
          "type": "string"
        },
        "format": {
          "title": "Format",
          "type": "string"
        },
