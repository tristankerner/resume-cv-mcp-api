          "title": "When Company Unknown",
          "type": "string"
        },
        "never_claim": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Never Claim",
          "type": "array"
        },
        "closing": {
          "title": "Closing",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "length",
        "addressing",
        "when_company_unknown",
        "closing"
      ],
      "title": "CoverLetterGuidance",
      "type": "object"
