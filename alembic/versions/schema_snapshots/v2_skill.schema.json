    "RequiredInput": {
      "additionalProperties": false,
      "description": "A value the finished document cannot go out without.\n\nContact details used to live in the skill because the public feed omitted\nthem on purpose. They are in the private resume now, so the usual case is\n`resolve_from` finding one \u2014 but a resolved value still has to be right for\nthis application, hence `confirm_with_user`.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
