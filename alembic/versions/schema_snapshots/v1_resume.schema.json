    "FineTuningData": {
      "additionalProperties": false,
      "description": "Private material the resume itself carries for a tailoring run.\n\nThe rules that used to live here \u2014 tailoring, professional summary, work\norder \u2014 are in `ResumeSkill` now, which is the document the MCP client\nactually reads. Two places to write a rule and only one of them consulted is\nworse than either place on its own. What stays is what is genuinely *about\nthis person* rather than about the procedure: how to reach them, and the\nfirst-person material a cover letter turns on.",
      "properties": {
        "email_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
