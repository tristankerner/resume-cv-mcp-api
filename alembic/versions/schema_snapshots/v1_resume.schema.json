    "SkillPrivate": {
      "additionalProperties": false,
      "description": "A skill with the two ratings that decide whether it makes the cut.\n\nPrivate, and not because they are sensitive on their own: they are a candid\nself-assessment of an inventory the website publishes in full, and a public\n`familiar` beside a stale `last_used` reads as a disclaimer attached to my\nown skill list. The site does not render them either, so nothing is lost by\nkeeping them on this side.",
      "properties": {
        "publish": {
          "default": true,
          "description": "False withholds this entry from the public feed only. It has no bearing on a tailored resume or cover letter: an entry withheld from a published website is often exactly the one to lead with in an application. Absent means published.",
          "title": "Publish",
          "type": "boolean"
        },
