# `development` or `production`. Development is the default, and leaves /docs,
# /redoc and /openapi.json open. Set it to production anywhere reachable from
# the internet: the docs then require a username and password from the users
# table — any active account — through an HTML login page (and, for an
# MFA-enrolled account, a code) rather than HTTP Basic. Nothing else branches
# on this.
ENVIRONMENT=development

# Signing key for access tokens, MFA challenges, and the docs-session cookie —
# all three are JWTs distinguished by a token_use claim. Generate a fresh one
# per deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
# How long a documentation login lasts before it has to happen again.
DOCS_SESSION_MINUTES=60

# --- Login throttling ---------------------------------------------------
# Failed password logins are counted, per account and per calling address.
# Every value below has a working default, so the whole block can be deleted.
# Applies to /token and to the docs login, which share one code path; API keys
# are not throttled — they are 32 bytes of randomness with no dictionary to
# attack, so there is no guessing to slow down.

# Off disables both counters. Meant for the test suite, not for a deployment:
# a lockout switched off locally is a lockout nobody notices is broken.
AUTH_LOCKOUT_ENABLED=true

# Failed attempts within the window that lock an account, and how far back
# the window reaches. The window is fixed rather than sliding, so a patient
# attacker retains a sustained four-guesses-per-15-minutes at these values.
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_MINUTES=15

# The first lock lasts this long, and each further lock without a successful
# login in between doubles it: 15 minutes, then 30, then 60.
AUTH_LOCKOUT_BASE_MINUTES=15

# Which lock stops being temporary. At 4: three escalating waits, then an
# admin has to run `DELETE /users/{id}/lock` or `python -m admin_cli unlock`.
# A successful login resets the ladder, so an account in daily use cannot be
# walked up to this by an outsider. A lock never blocks an API key, which is
# what keeps a locked-out admin able to unlock themselves.
AUTH_LOCKOUT_PERMANENT_AFTER_LOCKS=4

# The same idea keyed on the caller's address, which is what catches one guess
# each across a list of usernames — no single account sees enough failures to
# lock. Bans here are always temporary; an address is a lease, not an identity.
AUTH_IP_MAX_FAILURES=20
AUTH_IP_WINDOW_MINUTES=15
AUTH_IP_BAN_MINUTES=15

# How many proxies sit in front of this process, counted from the RIGHT of
# X-Forwarded-For. Not the leftmost entry: a client can send that header
# itself and the proxy appends rather than replaces, so everything left of
# our own hops is attacker-chosen. 1 is right for Cloud Run with no load
# balancer; add one per additional proxy. 0 turns address throttling off,
# which is the honest setting when nothing trustworthy sets the header —
# including a service exposed directly, where it cannot be believed at all.
AUTH_TRUSTED_PROXY_HOPS=1

# --- Multi-factor authentication -----------------------------------------
# Per-account and opt-in: there is no switch here that turns MFA on or off
# service-wide, only ones that shape the challenge once an account has
# enrolled a second factor. See the README's "Second factors".

# How long the token /token, the docs login, or POST /oauth/authorize returns
# after a correct password stays redeemable with a code.
MFA_CHALLENGE_TTL_MINUTES=5

# Thirty-second steps either side of now that a TOTP code is accepted for.
# 1 tolerates roughly ninety seconds of clock skew between a phone and this
# server; 0 demands perfectly synchronised clocks and will generate support
# requests.
MFA_TOTP_DRIFT_STEPS=1

# How many single-use backup codes a set contains. Regenerating replaces the
# set outright — there is only ever one live.
MFA_BACKUP_CODE_COUNT=10

# The issuer name an authenticator app shows beside the account. Purely
# cosmetic; worth setting when one person runs more than one of these.
MFA_ISSUER=resume-api

# Fernet keys that seal TOTP secrets at rest, newest first: every key listed
# can decrypt, the first one encrypts. Comma-separated for more than one, for
# rotation — prepend a new key and leave the old one until TotpMethod.verify's
# lazy re-seal has worked through the enrolled accounts, then drop it.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset locally, where a development database has nothing worth encrypting.
# REQUIRED in production: startup refuses to start without one, because a
# plaintext TOTP seed is symmetric — whoever reads the row can mint valid
# codes for that account forever. Deliver this through SECRETS_DIR, not this
# file or a bare environment variable: docker inspect reads env vars, and
# this key is the whole of what stands between a database dump and every
# account's second factor. Back it up somewhere other than beside the
# database dump — a backup holding both is a backup with no encryption.
# Losing every configured key locks every enrolled account out of password
# login; startup's verify_mfa_key check catches a wrong key and refuses to
# start rather than let that surface as everyone's login breaking at once.
# The break-glass path when this setting itself is the thing that's wrong is
# `python -m admin_cli reset-mfa`, which deletes MFA rows without ever
# decrypting them.
# MFA_ENCRYPTION_KEYS=

DATABASE_URL=sqlite+aiosqlite:///data/app.db
# Postgres instead — asyncpg for the app, which alembic/env.py rewrites to
# psycopg for the migrations. Neon requires TLS:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/resume_api?ssl=require
# Echoes every statement, with bind parameters, to the log. Leave off outside
# of local debugging: user writes carry password hashes.
DATABASE_ECHO=false

# `alembic upgrade head` before the first request. On by default so a local run
# needs nothing extra. Set false where the deployment pipeline migrates: on a
# scale-to-zero host this runs on every cold start, and parallel starts race for
# the same lock. Turning it off makes the pipeline responsible for the schema —
# startup will fail rather than serve against one it does not expect.
RUN_MIGRATIONS_ON_STARTUP=true

# --- First start only ---------------------------------------------------
# Migrations seed no users. On a database with no admin, and only then, these
# create one; afterwards they are ignored, so they can stay set in a compose
# file without recreating anything on restart. Password must satisfy the same
# rules the API enforces: 8+ characters with upper, lower, digit and symbol.
# Startup fails if these are set but cannot produce an admin.
# Leave unset to create the admin by hand instead:
# python -m admin_cli bootstrap-admin
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# --- OAuth 2.1 (MCP connectors) ------------------------------------------
# See docs/oauth-setup.md. Both required, with no default.

# The service's own issuer/resource URL. Defaults to http://localhost:8000
# outside production; set explicitly there — every OAuth token is checked
# against it, so a wrong value rejects them all with no useful error.
PUBLIC_BASE_URL=http://localhost:8000

# Hosts a Dynamic-Client-Registration request's redirect_uri may target.
# Comma-separated, any number of entries, one leading "*." wildcard per entry.
# claude.ai covers Claude web, Desktop, mobile and Cowork; Claude Code's
# loopback redirect is allowed by a built-in rule and must not be listed here.
OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai

# Whether POST /oauth/register accepts anonymous Dynamic Client Registration.
# Off by default: the endpoint cannot require a credential, so leaving it on
# is an unauthenticated database write anyone who finds it can repeat. Closed,
# it 404s and the metadata document omits registration_endpoint entirely.
# Register clients with `POST /oauth-clients` instead (requires users:admin
# and an interactive login) — both Claude Code (--client-id) and claude.ai
# (Advanced settings) accept the resulting credentials.
OAUTH_REGISTRATION_ENABLED=false

# --- Browser client (clients/web/) ----------------------------------------
# Origins allowed to call the authenticated routes (/token, /documents,
# /api-keys, /users/*) from a browser. Comma-separated, empty by default,
# which is exactly today's behaviour: no browser can read these responses.
# Serve clients/web/index.html over a local static server and this one value
# is all it needs.
CLIENT_ALLOWED_ORIGINS=http://localhost:5173

# Add "null" ONLY if you want to open clients/web/index.html straight off
# disk, and prefer the localhost origin above if you have the choice.
#
# "null" is not just "the file:// origin". It is what *any* website gets by
# putting a request inside a sandboxed iframe, so unlike every other entry
# here it names no one — allowlisting it lets an arbitrary page read
# responses from this API using the browser of whoever visits it. What that
# is worth to an attacker is bounded: there are no cookies, and the token
# lives in the real client origin's localStorage where a null-origin frame
# cannot reach it, so nothing authenticated is exposed. What it does give
# away is the unauthenticated surface — chiefly whether a /token login
# succeeded, which turns any visitor's browser into a credential-testing
# proxy against this service. The per-address lockout still throttles that;
# it does not remove it.
#
# Local use only — a production deployment should not set this.
# CLIENT_ALLOWED_ORIGINS=null,http://localhost:5173

# Serve the client same-origin instead: unset by default, so the API depends
# on no build artifact and nothing changes for a deployment that does not
# want this. Set it to the client's build output — clients/web/dist/index.html
# after `npm run build` in that repository — and GET /client returns that
# file. Same-origin means CLIENT_ALLOWED_ORIGINS does not even need to name
# it. Not clients/web/index.html: that is the Vite entry stub, and serving it
# renders a blank page that asks this API for /src/main.tsx.
# CLIENT_HTML_PATH=./clients/web/dist/index.html

# --- Docker -------------------------------------------------------------
# Point this at a secrets mount and any setting above can be supplied as a
# file instead of an environment variable — one file per lowercased name,
# e.g. /run/secrets/bootstrap_admin_password. Preferred for the two secrets
# above, since environment variables are visible in `docker inspect`.
# SECRETS_DIR=/run/secrets
